---
// 功能：按 0.3.0 的页签和用途分九组（手表、今天、待办、小耳、对话和认人、搜索、导出和分享、转文字和大模型、数据和隐私），
// 一组一节，左边文字、右边这一组的截图。内容跟首页同一份（src/lib/features.ts）。
import PageIntro from '../components/PageIntro.astro';
import Shot from '../components/Shot.astro';
import Base from '../layouts/Base.astro';
import { DATA, GROUPS } from '../lib/features';
import { SHOTS, SHOTS_NOTE } from '../lib/shots';
import { STATUS } from '../lib/site';
import { withBase } from '../lib/url';
import '../styles/page-motion.css';
---

<Base title="功能" description="饭耳能做什么：手表全天录，今天页一眼看完，待办滑卡，小耳的一句话和每天的总结，认人、搜索、导出分享，转文字和大模型用你自己选的，数据留在你手机上。">
	<main id="main" class="wrap">
		<PageIntro title="功能">
			<p>按 App 的页签和用途分组，写的是 0.3.0 里的样子。饭耳{STATUS.label}，{STATUS.text}</p>
			<p>{SHOTS_NOTE}想知道怎么一步步用起来，看<a href={withBase('/guide/')}>使用说明</a>。</p>
		</PageIntro>

		<nav class="jump" aria-label="功能分组">
			<ul>
				{GROUPS.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
			</ul>
		</nav>

		{
			GROUPS.map((g) => {
				const watch = g.shots.length > 0 && SHOTS[g.shots[0]].device === 'watch';
				return (
					<section id={g.id} class:list={['feature', g.shots.length > 0 && 'has-shot', watch && 'has-watch', g.shots.length > 1 && !watch && 'has-two']} aria-labelledby={`h-${g.id}`}>
						<div class="feature-text">
							<h2 id={`h-${g.id}`}>{g.title}</h2>
							<p class="feature-lead">{g.lead}</p>
							{g.id === 'data' ? (
								<dl class="facts">
									{DATA.map((fact) => (
										<div>
											<dt>{fact.title}</dt>
											<dd>{fact.text}</dd>
										</div>
									))}
								</dl>
							) : (
								<ul>
									{g.points.map((point) => (
										<li>{point.text}</li>
									))}
								</ul>
							)}
							{g.id === 'data' && <p class="feature-more">全文看<a href={withBase('/privacy/')}>隐私说明</a>。</p>}
						</div>
						{g.shots.length > 0 && (
							<div class:list={['feature-shots', watch && 'watch-row']}>
								{g.shots.map((id) => (
									<Shot id={id} sizes={watch ? '(min-width: 900px) 150px, 30vw' : '(min-width: 900px) 260px, 70vw'} />
								))}
							</div>
						)}
					</section>
				);
			})
		}
	</main>
</Base>

<style>
	.wrap {
		max-width: calc(var(--page-max) + 2 * var(--gutter));
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	/* 九组的目录：一行一行折，点了跳到那一组 */
	.jump ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
		margin: 0 0 var(--s-6);
		padding: 0;
		list-style: none;
	}

	.jump a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 var(--s-3);
		border: 1px solid var(--c-line);
		border-radius: var(--r-tag);
		color: var(--c-ink);
		font-size: 15px;
		text-decoration: none;
	}

	.jump a:hover {
		border-color: var(--c-ink);
	}

	.jump a:active {
		background: var(--c-wash);
	}

	.feature {
		padding: var(--s-7) 0;
		border-top: 1px solid var(--c-line);
		scroll-margin-top: var(--s-4);
	}

	.feature-text {
		max-width: var(--measure);
	}

	h2 {
		font-size: 26px;
	}

	.feature-lead {
		margin-top: var(--s-3);
		font-size: 19px;
		line-height: 1.65;
	}

	ul {
		margin: var(--s-4) 0 0;
		padding-left: 1.2em;
		color: var(--c-ink-2);
	}

	.feature-text li + li {
		margin-top: var(--s-2);
	}

	li::marker {
		color: var(--c-ink-3);
	}

	.facts {
		margin: var(--s-4) 0 0;
	}

	.facts div {
		padding: var(--s-3) 0;
		border-top: 1px solid var(--c-line);
	}

	.facts dt {
		font-weight: 700;
	}

	.facts dd {
		margin: var(--s-1) 0 0;
		color: var(--c-ink-2);
		font-size: 16px;
		line-height: 1.6;
	}

	.feature-more {
		margin-top: var(--s-4);
		color: var(--c-ink-2);
		font-size: 16px;
	}

	.feature-shots {
		display: flex;
		justify-content: center;
		gap: var(--s-4);
		width: min(300px, 76%);
		margin: var(--s-6) auto 0;
	}

	.feature.has-two .feature-shots {
		width: min(540px, 100%);
	}

	.feature-shots > :global(*) {
		flex: 1;
		min-width: 0;
	}

	.watch-row {
		width: min(480px, 100%);
	}

	@media (min-width: 900px) {
		.feature.has-shot {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 280px;
			column-gap: var(--s-8);
			align-items: start;
		}

		.feature.has-two {
			grid-template-columns: minmax(0, 1fr) 500px;
		}

		.feature.has-watch {
			grid-template-columns: minmax(0, 1fr) 480px;
		}

		.feature-shots,
		.feature.has-two .feature-shots {
			width: 100%;
			margin: 0;
		}

		h2 {
			font-size: 30px;
		}
	}
</style>
