---
// 常见问题（本人 10-18：「做FAQ页面 汇总一些常用的疑问」）。先放本人点名的两件：选手表（建议买 Ultra）、
// 健康权限（以前手滑点错了，饭耳没法再提醒，要用户自己去改）；再收饭耳仓库 docs/user-insights/ 里用户问过、答案已经定了的。
// 规矩：只写真事；按钮名、设置项名照 App 界面上的原字，改了 App 文案这里也要跟着改。
// 本人北京 11-06（「我们减少在官网的描述」「不讲技术」）起只留买之前要知道的几条：选表、健康数据和隐私、花费和下载；
// 设置怎么改、出了问题怎么办留在 App 里的帮助，不写服务商、价钱和模型名。
// 按饭耳主线 1b747c1b（0.2.6 的 202610180137 构建）核对过（10-18），每一条的出处写在那一条上面。
import PageIntro from '../components/PageIntro.astro';
import Base from '../layouts/Base.astro';
import { STATUS, XHS } from '../lib/site';
import { withBase } from '../lib/url';
import '../styles/page-motion.css';

/** 问题原文。键就是页内锚点（比如 /faq/#health-permission），目录和标题都从这里取。 */
const Q = {
	ultra: '买哪款 Apple Watch？要不要买 Ultra？',
	'old-watch': '我现在的手表能用吗？',
	'health-use': '饭耳读健康数据做什么？会发给谁？',
	privacy: '我的录音会传给开发者吗？',
	price: '饭耳要钱吗？',
	download: '去哪下载饭耳？',
} as const;
type QId = keyof typeof Q;

/** 分组：目录和正文同一个顺序。 */
const GROUPS: Record<string, { title: string; items: readonly QId[] }> = {
	watch: { title: '选手表', items: ['ultra', 'old-watch'] },
	privacy: { title: '健康数据和隐私', items: ['health-use', 'privacy'] },
	cost: { title: '花费和下载', items: ['price', 'download'] },
};

/** 苹果官网「比较 Apple Watch 机型」（apple.com.cn/watch/compare/，10-18 取）的电池续航原文「最长可达 N 小时」。 */
const WATCHES = [
	{ name: 'Apple Watch Ultra 4', hours: 50, pick: true },
	{ name: 'Apple Watch Series 12', hours: 24, pick: false },
	{ name: 'Apple Watch SE 3', hours: 18, pick: false },
];
const MAX_HOURS = Math.max(...WATCHES.map((w) => w.hours));
---

<Base
	title="常见问题"
	description="饭耳常见问题：买哪款 Apple Watch、要不要买 Ultra，健康数据读来做什么，录音会不会传给开发者，要不要钱。"
>
	<main id="main" class="wrap">
		<PageIntro title="常见问题">
			<p>问得最多的 {Object.keys(Q).length} 个问题。按钮和设置项的名字照 App 上的字写。</p>
		</PageIntro>

		<div class="faq">
			<nav class="faq-index" aria-label="全部问题">
				{
					Object.values(GROUPS).map((group) => (
						<div class="faq-index-group">
							<p class="faq-index-title">{group.title}</p>
							<ul>
								{group.items.map((id) => (
									<li>
										<a href={`#${id}`}>{Q[id]}</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>

			<div class="faq-groups">
				<section class="faq-group" aria-labelledby="g-watch">
					<h2 id="g-watch">{GROUPS.watch.title}</h2>

					{/* 续航：苹果官网机型比较页原文（10-18 取）。 */}
					<div class="qa" id="ultra">
						<h3>{Q.ultra}</h3>
						<p><strong>建议买 Ultra。</strong>饭耳全天录音，手表的麦克风一直开着，最要紧的是续航。苹果官网写的电池续航：</p>
						<ul class="battery">
							{
								WATCHES.map((w) => (
									<li class:list={['battery-row', { pick: w.pick }]}>
										<span class="battery-name">
											{w.name}
											{w.pick && <span class="pick-tag">推荐</span>}
										</span>
										<span class="battery-value">最长 {w.hours} 小时</span>
										<span class="battery-track" aria-hidden="true">
											<span class="battery-bar" style={`width: ${(w.hours / MAX_HOURS) * 100}%`} />
										</span>
									</li>
								))
							}
						</ul>
						<p class="hint">数字出自苹果官网的机型比较页（2026 年 10 月），是苹果自己测的，不是开着饭耳录音时测的。</p>
					</div>

					<div class="qa" id="old-watch">
						<h3>{Q['old-watch']}</h3>
						<p>watchOS 10 以上的 Apple Watch 都能装，iPhone 要 iOS 17 以上。电池用旧了、续航短的表，可能撑不满一整天。</p>
					</div>
				</section>

				<section class="faq-group" aria-labelledby="g-privacy">
					<h2 id="g-privacy">{GROUPS.privacy.title}</h2>

					<div class="qa" id="health-use">
						<h3>{Q['health-use']}</h3>
						<p>回看对话时，对上你当时的身体状态，比如说某句话时的心率。要读哪几项，iPhone 会逐项列出来，你自己选；一项不开也能录音。</p>
						<p>默认只在饭耳里显示。在「设置」里打开「允许大模型调用健康数据」，才会发给你自己配的大模型。不会自动发给开发者。</p>
						<p class="hint">饭耳不是医疗器械，不做诊断。</p>
					</div>

					<div class="qa" id="privacy">
						<h3>{Q.privacy}</h3>
						<p>录音、转写文字和健康数据都不会自动传给开发者。转文字和大模型的请求从你的手机直接发给你选的服务商，不经过开发者的服务器。</p>
						<p>录音存在你的手机上，默认还在你自己的 iCloud 里存一份。详见<a href={withBase('/privacy/')}>隐私说明</a>。</p>
					</div>
				</section>

				<section class="faq-group" aria-labelledby="g-cost">
					<h2 id="g-cost">{GROUPS.cost.title}</h2>

					<div class="qa" id="price">
						<h3>{Q.price}</h3>
						<p>饭耳免费。要花钱的只有你自己选的云端服务，钱直接付给服务商。</p>
					</div>

					<div class="qa" id="download">
						<h3>{Q.download}</h3>
						<p>{STATUS.label}，{STATUS.text}{STATUS.follow}</p>
					</div>
				</section>

				<p class="faq-more">没找到你的问题？{XHS.search}，问我。</p>
			</div>
		</div>
	</main>
</Base>

<style>
	.wrap {
		max-width: calc(var(--page-max) + 2 * var(--gutter));
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	/* 目录：手机上放在最前面，一组一组列出全部问题；电脑上是左边一列，跟着滚 */
	.faq-index {
		padding: var(--s-5) 0;
		border-top: 1px solid var(--c-line);
	}

	.faq-index-group + .faq-index-group {
		margin-top: var(--s-4);
	}

	.faq-index-title {
		color: var(--c-ink-3);
		font-size: 14px;
		font-weight: 700;
	}

	.faq-index ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.faq-index a {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: var(--s-1) 0;
		/* 用链接的我蓝，一眼看出能点 */
		color: var(--c-me);
		font-size: 16px;
		line-height: 1.5;
		text-decoration: none;
		touch-action: manipulation;
	}

	.faq-index a:hover {
		color: var(--c-me-press);
		text-decoration: underline;
	}

	.faq-index a:active {
		background: var(--c-wash);
	}

	.faq-group {
		padding-top: var(--s-6);
		border-top: 1px solid var(--c-line);
	}

	.faq-group + .faq-group {
		margin-top: var(--s-7);
	}

	.faq-group h2 {
		font-size: 26px;
	}

	.qa {
		max-width: var(--measure);
		margin-top: var(--s-5);
		/* 点目录跳过来时，问题不贴着屏幕顶 */
		scroll-margin-top: var(--s-4);
	}

	.qa + .qa {
		margin-top: var(--s-6);
	}

	.qa h3 {
		font-size: 19px;
	}

	.qa p,
	.qa .battery {
		margin-top: var(--s-3);
	}

	.hint {
		color: var(--c-ink-2);
		font-size: 16px;
	}

	/* 续航对比：一款表一行，上面是名字和小时数，下面一根条，长短按小时数；推荐的那款条是我蓝，名字旁边写「推荐」 */
	.battery {
		display: grid;
		gap: var(--s-4);
		margin-bottom: 0;
		padding: 0;
		list-style: none;
	}

	.battery-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		column-gap: var(--s-3);
		row-gap: var(--s-2);
	}

	.battery-name {
		font-size: 16px;
		font-weight: 600;
	}

	.pick-tag {
		display: inline-flex;
		align-items: center;
		min-height: 22px;
		margin-left: var(--s-2);
		padding: 0 var(--s-2);
		border: 1px solid var(--c-me);
		border-radius: var(--r-tag);
		color: var(--c-me);
		font-size: 13px;
		font-weight: 600;
		line-height: 1;
		vertical-align: 1px;
	}

	.battery-value {
		color: var(--c-ink);
		font-size: 16px;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.battery-track {
		grid-column: 1 / -1;
		height: 10px;
		overflow: hidden;
		border-radius: var(--r-tag);
		background: var(--c-wash);
	}

	.battery-bar {
		display: block;
		height: 100%;
		border-radius: 0 var(--r-tag) var(--r-tag) 0;
		background: var(--c-ink-3);
	}

	.pick .battery-bar {
		background: var(--c-me);
	}

	.faq-more {
		margin-top: var(--s-7);
		padding: var(--s-5) 0 var(--s-6);
		border-top: 1px solid var(--c-line);
		color: var(--c-ink-2);
	}

	/* 电脑：左边一列目录，右边正文 */
	@media (min-width: 1024px) {
		.faq {
			display: grid;
			grid-template-columns: 260px minmax(0, 1fr);
			column-gap: var(--s-7);
			align-items: start;
		}

		.faq-index {
			position: sticky;
			top: var(--s-4);
			max-height: calc(100vh - 2 * var(--s-4));
			overflow-y: auto;
			padding: var(--s-6) 0 var(--s-5);
		}

		.faq-index a {
			min-height: 40px;
			font-size: 15px;
		}
	}
</style>
