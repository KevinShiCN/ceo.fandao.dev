---
// 更新记录：只列对外发布的版本和每一版的重点（本人北京 11-06：「包括更新日志也不写那么多了」）。
// 数据是 src/data/changelog.json，同步命令从 fanear 仓库的 CHANGELOG.md、CHANGELOG-HIGHLIGHTS.md 生成（src/lib/changelog.mjs 的 publicChangelog）；
// 测试版和每一条细节不进官网，也不进这个仓库。
import PageIntro from '../components/PageIntro.astro';
import data from '../data/changelog.json';
import Base from '../layouts/Base.astro';
import { dateText } from '../lib/changelog.mjs';

const { versions } = data;
if (versions.length === 0) throw new Error('src/data/changelog.json 里一个对外版本都没有');
---

<Base title="更新记录" description="饭耳对外发布的每个版本和它的重点。">
	<main id="main" class="wrap">
		<PageIntro title="更新记录">
			<p>只写对外发布的版本和每一版的重点，新的在上面。</p>
		</PageIntro>

		<ol class="versions">
			{
				versions.map((v) => (
					<li id={v.anchor} class="version">
						<div class="version-head">
							<h2>
								<a href={`#${v.anchor}`}>{v.version}</a>
							</h2>
							{v.date && <time datetime={v.date}>{dateText(v.date)}</time>}
						</div>
						{v.highlights.length > 0 && (
							<ul class="highlights">
								{v.highlights.map((text) => (
									<li>{text}</li>
								))}
							</ul>
						)}
					</li>
				))
			}
		</ol>
	</main>
</Base>

<style>
	.wrap {
		max-width: calc(var(--measure) + 2 * var(--gutter));
		margin: 0 auto;
		padding: 0 var(--gutter) var(--s-8);
	}

	.versions {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.version {
		padding: var(--s-4) 0;
		border-top: 1px solid var(--c-line);
		scroll-margin-top: var(--s-4);
	}

	.version-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--s-1) var(--s-3);
	}

	h2 {
		font-size: 24px;
		font-weight: 800;
		letter-spacing: 0.01em;
	}

	h2 a {
		color: var(--c-ink);
		text-decoration: none;
	}

	h2 a:hover {
		color: var(--c-me);
	}

	time {
		color: var(--c-ink-3);
		font-size: 15px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.highlights {
		margin: var(--s-2) 0 0;
		padding-left: 1.2em;
		color: var(--c-ink-2);
		font-size: 17px;
		line-height: 1.65;
	}
</style>
