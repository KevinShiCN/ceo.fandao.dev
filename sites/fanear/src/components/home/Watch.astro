---
// 手表上：录音这件事配手表的三种样子（正在录、被打断、自己停的），每张图旁边一句话。
// 手机上一张一行（图左字右），电脑上三张并排。句子都在 src/lib/features.ts（WATCH_STATES）。
import { group, WATCH_FOOT, WATCH_STATES } from '../../lib/features';
import { SHOTS } from '../../lib/shots';
import Shot from '../Shot.astro';

const watch = group('watch');
---


<section class="watch" aria-labelledby="h-c-record">
	<div class="watch-head">
		<h3 id="h-c-record">全天录</h3>
		<p class="watch-lead">{watch.lead}</p>
	</div>
	<ul class="states">
		{
			WATCH_STATES.map((state) => (
				<li>
					<Shot id={state.shot} caption={false} sizes="(min-width: 768px) 200px, 34vw" />
					<div class="state-text">
						<h4>{SHOTS[state.shot].caption}</h4>
						<p>{state.text}</p>
					</div>
				</li>
			))
		}
	</ul>
	<p class="watch-foot">{WATCH_FOOT}</p>
</section>

<style>
	.watch {
		padding-top: var(--s-6);
	}

	h3 {
		font-size: 26px;
		font-weight: 800;
		line-height: 1.3;
	}

	.watch-lead {
		max-width: 30em;
		margin-top: var(--s-3);
		font-size: 18px;
		line-height: 1.65;
	}

	.states {
		display: grid;
		gap: var(--s-5);
		margin: var(--s-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.states li {
		display: grid;
		grid-template-columns: 34vw minmax(0, 1fr);
		align-items: center;
		gap: var(--s-4);
	}

	h4 {
		font-size: 19px;
		font-weight: 700;
	}

	.state-text p {
		margin-top: var(--s-1);
		color: var(--c-ink-2);
		font-size: 16px;
		line-height: 1.6;
	}

	.watch-foot {
		margin-top: var(--s-5);
		padding-top: var(--s-3);
		border-top: 1px solid var(--c-line);
		color: var(--c-ink-2);
		font-size: 16px;
	}

	@media (min-width: 768px) {
		.watch {
			padding-top: var(--s-7);
		}

		h3 {
			font-size: 34px;
		}

		.watch-lead {
			font-size: 20px;
		}

		.states {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--s-6);
			margin-top: var(--s-7);
		}

		.states li {
			grid-template-columns: none;
			align-content: start;
			gap: var(--s-5);
		}

		.states li > :global(.shot) {
			width: 200px;
		}
	}
</style>
