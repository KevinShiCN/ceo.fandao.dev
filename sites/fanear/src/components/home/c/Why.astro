---
// 为什么做：我用过、等过的几个，为什么还是自己做，以及饭耳的几条规矩（免费、饭导五常大米、先照我的需要做）。
// 写法像一封短信，不做对比表；文案和出处在 src/lib/why.ts。
import { MAKER } from '../../../lib/site';
import { withBase } from '../../../lib/url';
import { WHY } from '../../../lib/why';
---

<section class="why" aria-label="为什么做">
	<p class="why-lead">{WHY.lead}</p>
	<dl class="why-others">
		{
			WHY.others.map((other) => (
				<div>
					<dt>{other.name}</dt>
					<dd>{other.text}</dd>
				</div>
			))
		}
	</dl>
	<p class="why-turn">{WHY.turn}</p>
	<dl class="why-terms">
		{
			WHY.terms.map((term) => (
				<div>
					<dt>{term.title}</dt>
					<dd>
						{term.text}
						{term.shop && (
							<div class="why-shop">
								<img class="why-shop-qr" src={withBase(MAKER.shop.qr)} width="112" height="112" alt={MAKER.shop.qrAlt} loading="lazy" />
								<span class="why-shop-hint">用微信扫一扫，或者点：</span>
								<a href={MAKER.shop.url}>{MAKER.shop.label}</a>
							</div>
						)}
					</dd>
				</div>
			))
		}
	</dl>
</section>

<style>
	.why {
		padding-top: var(--s-5);
	}

	.why-lead {
		max-width: var(--measure);
		color: var(--c-ink-2);
		font-size: 18px;
	}

	.why-others {
		max-width: var(--measure);
		margin: var(--s-3) 0 0;
	}

	.why-others div {
		display: grid;
		grid-template-columns: 4.5em minmax(0, 1fr);
		gap: var(--s-3);
		align-items: baseline;
		padding: var(--s-3) 0;
		border-top: 1px solid var(--c-line);
	}

	.why-others dt {
		font-weight: 700;
	}

	.why-others dd {
		margin: 0;
		color: var(--c-ink-2);
	}

	/* 这一句是整节要说的话：字最大 */
	.why-turn {
		max-width: 20em;
		margin-top: var(--s-6);
		font-size: 22px;
		font-weight: 700;
		line-height: 1.5;
	}

	.why-terms {
		margin: var(--s-5) 0 0;
	}

	.why-terms > div {
		padding: var(--s-3) 0;
		border-top: 2px solid var(--c-ink);
	}

	.why-terms > div + div {
		margin-top: var(--s-3);
	}

	.why-terms dt {
		font-size: 18px;
		font-weight: 700;
	}

	.why-terms dd {
		margin: var(--s-1) 0 0;
		color: var(--c-ink-2);
		font-size: 16px;
		line-height: 1.6;
	}

	/* 小店入口：手机上只有链接（点了唤起微信），二维码留给电脑，用手机微信扫 */
	.why-shop {
		display: grid;
		justify-items: start;
		gap: var(--s-2);
		margin-top: var(--s-2);
	}

	.why-shop a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}

	.why-shop-qr,
	.why-shop-hint {
		display: none;
	}

	@media (min-width: 900px) {
		.why-shop-qr {
			display: block;
			border: 1px solid var(--c-line);
		}

		.why-shop-hint {
			display: block;
			color: var(--c-ink-3);
			font-size: 14px;
		}

		.why-lead {
			font-size: 20px;
		}

		.why-turn {
			font-size: 30px;
		}

		/* 电脑：几条规矩就并排几列 */
		.why-terms {
			display: grid;
			grid-auto-columns: minmax(0, 1fr);
			grid-auto-flow: column;
			gap: var(--s-6);
		}

		.why-terms > div + div {
			margin-top: 0;
		}
	}
</style>
