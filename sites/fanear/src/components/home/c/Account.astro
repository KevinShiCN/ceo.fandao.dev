---
// 用你自己的账号：没有截图，写成说明书里的一张小表——转文字、整理对话、密钥、录音和文字各放在哪。
import { feature, point } from './pick';

const own = feature('own-account');
const transcribe = feature('transcribe');
const organize = feature('organize');
const rows = [
	{ label: '转文字', text: point(transcribe, '火山') },
	{ label: '整理对话', text: point(organize, '大模型') },
	{ label: '密钥', text: point(own, '钥匙串') },
	{ label: '录音和文字', text: point(own, '7 天') },
];
---

<section class="account" aria-labelledby="h-c-account">
	<div class="account-inner">
		<div class="account-head">
			<h2 id="h-c-account">{own.title}</h2>
			<p>{own.lead}</p>
		</div>
		<dl class="account-rows">
			{
				rows.map((row) => (
					<div>
						<dt>{row.label}</dt>
						<dd>{row.text}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.account {
		margin-top: var(--s-8);
		background: var(--c-wash);
	}

	.account-inner {
		max-width: calc(var(--page-max) + 2 * var(--gutter));
		margin: 0 auto;
		padding: var(--s-7) var(--gutter);
	}

	h2 {
		font-size: 26px;
		font-weight: 800;
	}

	.account-head p {
		margin-top: var(--s-3);
		font-size: 18px;
		line-height: 1.65;
	}

	.account-rows {
		margin: var(--s-5) 0 0;
	}

	.account-rows div {
		padding: var(--s-3) 0;
		border-top: 1px solid var(--c-line);
	}

	dt {
		font-size: 15px;
		font-weight: 700;
	}

	dd {
		margin: var(--s-1) 0 0;
		color: var(--c-ink-2);
		font-size: 16px;
		line-height: 1.6;
	}

	@media (min-width: 768px) {
		.account {
			margin-top: var(--s-9);
		}

		.account-inner {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
			gap: var(--s-8);
			padding-top: var(--s-8);
			padding-bottom: var(--s-8);
		}

		h2 {
			font-size: 34px;
		}

		.account-head p {
			font-size: 20px;
		}

		.account-rows {
			margin-top: 0;
		}

		.account-rows div {
			display: grid;
			grid-template-columns: 7em minmax(0, 1fr);
			gap: var(--s-4);
			align-items: baseline;
			padding: var(--s-4) 0;
		}

		dd {
			margin: 0;
		}
	}
</style>
