---
// 「我」：先介绍我，再介绍饭耳（跟 App 第一次打开的介绍页同一个顺序和原话，文案在 src/lib/why.ts）。
// 顺序：ADHD 那段、心愿（首屏 A 才放这里；首屏 B 放在照片旁边）→ 饭耳做什么的四行 → 首发就支持中文 →
// 四条规矩（免费、饭导五常大米、先照我的需要做、你的需要也可以提）→ 我用过、等过的几个 → 最后两句。
// 写法像一封短信，不做对比表；小标题只给读屏，页面上不放（同 App「不放小标题」）。
import { MAKER, WISH, XHS } from '../../lib/site';
import { withBase } from '../../lib/url';
import { INTRO, splitPoint, WHY } from '../../lib/why';
import Opening from './Opening.astro';

interface Props {
	/** 开头两句放不放在这里（首屏 B 已经放在照片旁边了） */
	opening: boolean;
}

const { opening } = Astro.props;
---

<section class="why" aria-labelledby="h-why">
	<h2 id="h-why" class="visually-hidden">我为什么做饭耳</h2>
	{opening && <Opening class="why-opening" />}

	<ul class="why-points">
		{
			INTRO.points.map((point) => {
				const [lead, rest] = splitPoint(point.text);
				return (
					<li>
						<strong>{lead}</strong>
						{rest}
						{'note' in point && <span class="why-note">{point.note}</span>}
					</li>
				);
			})
		}
	</ul>

	<p class="why-tagline">{INTRO.tagline}</p>

	<dl class="why-terms">
		{
			WHY.terms.map((term) => (
				<div>
					<dt>{term.title}</dt>
					<dd>
						{term.text}
						{term.title === '免费' && <span class="why-xhs">{XHS.search}。</span>}
						{'shop' in term && (
							<div class="why-shop">
								<img class="why-shop-qr" src={withBase(MAKER.shop.qr)} width="112" height="112" alt={MAKER.shop.qrAlt} loading="lazy" />
								<span class="why-shop-hint">用微信扫一扫，或者点：</span>
								<a href={MAKER.shop.url}>{MAKER.shop.label}</a>
							</div>
						)}
						{'wish' in term && (
							<div class="why-wish">
								<a href={WISH.url}>{WISH.label}</a>
							</div>
						)}
					</dd>
				</div>
			))
		}
	</dl>

	<p class="why-lead">{WHY.lead}</p>
	<dl class="why-others">
		{
			WHY.others.map((other) => (
				<div>
					<dt>{other.name}</dt>
					<dd>{other.text}</dd>
				</div>
			))
		}
	</dl>
	<p class="why-close">{INTRO.close.map((line) => <span>{line}</span>)}</p>
</section>

<style>
	.why {
		padding-top: var(--s-7);
	}

	.why :global(.why-opening) {
		margin-bottom: var(--s-7);
	}

	/* 饭耳做什么：四行，每行前半句加粗；电脑上两列 */
	.why-points {
		display: grid;
		gap: 0;
		max-width: 920px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.why-points li {
		padding: var(--s-4) 0;
		border-top: 1px solid var(--c-line);
		color: var(--c-ink-2);
		font-size: 17px;
		line-height: 1.7;
	}

	.why-points strong {
		color: var(--c-ink);
		font-weight: 700;
	}

	.why-note {
		display: block;
		margin-top: var(--s-2);
		color: var(--c-ink);
	}

	/* App 里同样是主色的一行小标语 */
	.why-tagline {
		margin-top: var(--s-6);
		color: var(--c-me);
		font-size: 18px;
		font-weight: 700;
	}

	.why-terms {
		margin: var(--s-7) 0 0;
	}

	.why-terms > div {
		padding: var(--s-3) 0;
		border-top: 2px solid var(--c-ink);
	}

	.why-terms > div + div {
		margin-top: var(--s-3);
	}

	.why-terms dt {
		font-size: 18px;
		font-weight: 700;
	}

	.why-terms dd {
		margin: var(--s-1) 0 0;
		color: var(--c-ink-2);
		font-size: 16px;
		line-height: 1.65;
		text-wrap: pretty;
	}

	.why-xhs {
		display: block;
		margin-top: var(--s-2);
		color: var(--c-ink);
		font-weight: 600;
	}

	/* 小店入口：手机上只有链接（点了唤起微信），二维码留给电脑，用手机微信扫 */
	.why-shop {
		display: grid;
		justify-items: start;
		gap: var(--s-2);
		margin-top: var(--s-2);
	}

	.why-wish {
		margin-top: var(--s-2);
	}

	.why-shop a,
	.why-wish a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}

	.why-shop-qr,
	.why-shop-hint {
		display: none;
	}

	.why-lead {
		margin-top: var(--s-8);
		color: var(--c-ink-2);
		font-size: 18px;
	}

	.why-others {
		max-width: var(--measure);
		margin: var(--s-3) 0 0;
	}

	.why-others div {
		display: grid;
		grid-template-columns: 4.5em minmax(0, 1fr);
		gap: var(--s-3);
		align-items: baseline;
		padding: var(--s-3) 0;
		border-top: 1px solid var(--c-line);
	}

	.why-others dt {
		font-weight: 700;
	}

	.why-others dd {
		margin: 0;
		color: var(--c-ink-2);
	}

	/* 最后两句：这一节第二大的字，分两行 */
	.why-close {
		max-width: 22em;
		margin-top: var(--s-7);
		font-size: 22px;
		font-weight: 700;
		line-height: 1.5;
	}

	.why-close span {
		display: block;
	}

	.why-close span + span {
		margin-top: var(--s-2);
	}

	@media (min-width: 768px) {
		.why-points {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--s-7);
		}

		.why-points li {
			font-size: 18px;
		}

		.why-close {
			font-size: 28px;
		}
	}

	@media (min-width: 900px) {
		.why-shop-qr {
			display: block;
			border: 1px solid var(--c-line);
		}

		.why-shop-hint {
			display: block;
			color: var(--c-ink-3);
			font-size: 14px;
		}

		.why-lead {
			font-size: 20px;
		}

		/* 电脑：四条规矩并排四列 */
		.why-terms {
			display: grid;
			grid-auto-columns: minmax(0, 1fr);
			grid-auto-flow: column;
			gap: var(--s-6);
		}

		.why-terms > div + div {
			margin-top: 0;
		}
	}
</style>
