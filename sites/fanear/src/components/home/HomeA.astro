---
// 首页第 A 版「一天」：主角是 App「今天」最上面那条按时间画的时间条，放大成整页宽，
// 下面按时间列出这一天发生的几件事；再往下是真机截图、功能、最近更新。
// 数据全部来自 src/lib/demo.ts（跟 App 演示数据和截图同一天）。
import raw from '../../data/CHANGELOG.md?raw';
import { parseChangelog } from '../../lib/changelog.mjs';
import { DAY, type Fill } from '../../lib/demo';
import { FEATURES } from '../../lib/features';
import { SHOTS_NOTE } from '../../lib/shots';
import { STATUS } from '../../lib/site';
import { withBase } from '../../lib/url';
import Ribbon from '../Ribbon.astro';
import Shot from '../Shot.astro';

const log = parseChangelog(raw);
const latest = log.unreleased[0] ?? log.released[0];
const itemCount = [...log.unreleased, ...log.released].reduce((n, v) => n + v.items.length, 0);
const fillClass: Record<Fill, string> = {
	me: 'who-me',
	p1: 'who-p1',
	p2: 'who-p2',
	p3: 'who-p3',
	gap: 'who-gap',
	fail: 'who-fail',
};
const dateText = (iso: string) => `${Number(iso.slice(5, 7))}月${Number(iso.slice(8, 10))}日`;
---

<main id="main" class="home-a">
	<section class="hero">
		<h1>手表全天录音，<br />手机记下谁说了什么、谁答应了什么。</h1>
		<p class="hero-sub">
			Apple Watch 录，iPhone 转成文字、分清谁在说话，再把「我答应别人的」「别人答应我的」挑出来，等你点一下。
		</p>
		<div class="hero-actions">
			<a class="btn" href={withBase('/guide/')}>看使用说明</a>
			<a class="btn btn-line" href={withBase('/features/')}>看有哪些功能</a>
		</div>
		<p class="hero-note"><strong>{STATUS.label}</strong>：{STATUS.text}</p>
	</section>

	<section class="day" aria-labelledby="h-day">
		<div class="day-inner">
			<div class="day-head">
				<h2 id="h-day">戴一天下来，饭耳给你的是这样一条</h2>
				<p>{DAY.date}，演示数据</p>
			</div>
			<p class="day-summary">{DAY.summary}</p>
			<Ribbon class="day-ribbon" height={44} />
			<ol class="day-events">
				{
					DAY.events.map((event) => (
						<li>
							<time>{event.at}</time>
							<span class={`who ${fillClass[event.fill]}`} />
							<span class="event-body">
								<strong>{event.title}</strong>
								<span>{event.note}</span>
							</span>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="shots" aria-labelledby="h-shots">
		<h2 id="h-shots">手表上录，手机上看</h2>
		<div class="shots-row">
			<div class="shots-watch">
				<Shot id="watchRecording" />
				<Shot id="watchInterrupted" />
			</div>
			<Shot id="today" />
			<Shot id="conversation" />
			<Shot id="commitments" />
		</div>
		<p class="shots-note">{SHOTS_NOTE}</p>
	</section>

	<section class="features" aria-labelledby="h-features">
		<h2 id="h-features">能做什么</h2>
		<ul class="feature-list">
			{
				FEATURES.map((feature) => (
					<li>
						<a href={withBase(`/features/#${feature.id}`)}>
							<h3>{feature.title}</h3>
							<p>{feature.lead}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	{
		latest && (
			<section class="latest" aria-labelledby="h-latest">
				<h2 id="h-latest">最近更新</h2>
				<p class="latest-version">
					<strong>{latest.version}</strong>
					<span>{latest.note}</span>
				</p>
				<ul>
					{latest.items.slice(0, 3).map((item) => (
						<li>
							{item.date && <time datetime={item.date}>{dateText(item.date)}</time>}
							<span>{item.text}</span>
						</li>
					))}
				</ul>
				<a class="btn btn-line" href={withBase('/changelog/')}>
					看全部 {itemCount} 条更新
				</a>
			</section>
		)
	}
</main>

<style>
	.home-a {
		--wide: calc(var(--page-max) + 2 * var(--gutter));
	}

	.home-a > section {
		max-width: var(--wide);
		margin: 0 auto;
		padding-left: var(--gutter);
		padding-right: var(--gutter);
	}

	/* 首屏：左对齐的大字，按钮，状态一句 */
	.hero {
		padding-top: var(--s-7);
		padding-bottom: var(--s-7);
	}

	h1 {
		font-size: 31px;
		font-weight: 800;
		line-height: 1.3;
		letter-spacing: 0.01em;
	}

	.hero-sub {
		max-width: 34em;
		margin-top: var(--s-4);
		color: var(--c-ink-2);
		font-size: 18px;
		line-height: 1.7;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
		margin-top: var(--s-5);
	}

	.hero-note {
		margin-top: var(--s-4);
		color: var(--c-ink-3);
		font-size: 15px;
	}

	.hero-note strong {
		color: var(--c-ink);
	}

	/* 一天：整页宽的浅底一块，时间条是全页最显眼的东西 */
	.home-a > .day {
		max-width: none;
		padding: 0;
		background: var(--c-wash);
	}

	.day-inner {
		max-width: var(--wide);
		margin: 0 auto;
		padding: var(--s-7) var(--gutter);
	}

	.day-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s-1) var(--s-4);
	}

	h2 {
		font-size: 24px;
		line-height: 1.35;
	}

	.day-head p {
		color: var(--c-ink-3);
		font-size: 14px;
	}

	.day-summary {
		margin-top: var(--s-4);
		font-size: 18px;
		font-weight: 600;
		line-height: 1.6;
	}

	.day :global(.day-ribbon) {
		margin-top: var(--s-4);
	}

	/* 这一天的几件事：按时间排的真实顺序，所以用有序列表 */
	.day-events {
		display: grid;
		gap: var(--s-3);
		margin: var(--s-5) 0 0;
		padding: 0;
		list-style: none;
	}

	.day-events li {
		display: grid;
		grid-template-columns: 3.2em auto minmax(0, 1fr);
		column-gap: var(--s-2);
		align-items: baseline;
		font-size: 16px;
		line-height: 1.5;
	}

	.day-events time {
		color: var(--c-ink-3);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.event-body strong {
		display: block;
	}

	.event-body span {
		display: block;
		color: var(--c-ink-2);
		font-size: 15px;
	}

	/* 截图：手机上横着滑，电脑上一排放下 */
	.shots {
		padding-top: var(--s-8);
	}

	.shots-row {
		display: flex;
		gap: var(--s-5);
		margin: var(--s-5) calc(-1 * var(--gutter)) 0;
		padding: var(--s-5) var(--gutter) var(--s-6);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		/* 吸附按滚动区外沿对齐，留出跟左右内边距一样宽的吸附边距，第一张才不会贴到屏幕边上 */
		scroll-padding: 0 var(--gutter);
		-webkit-overflow-scrolling: touch;
	}

	.shots-row > :global(*) {
		flex: none;
		width: 62vw;
		max-width: 260px;
		scroll-snap-align: start;
	}

	.shots-row > .shots-watch {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--s-5);
		width: 40vw;
		max-width: 170px;
	}

	.shots-note {
		color: var(--c-ink-3);
		font-size: 14px;
	}

	/* 功能：两栏的清单，每条点进功能页对应的一节 */
	.features {
		padding-top: var(--s-8);
	}

	.feature-list {
		display: grid;
		margin: var(--s-4) 0 0;
		padding: 0;
		list-style: none;
	}

	.feature-list a {
		display: block;
		padding: var(--s-4) 0;
		border-top: 1px solid var(--c-line);
		color: var(--c-ink);
		text-decoration: none;
	}

	.feature-list a:hover h3 {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.22em;
	}

	.feature-list a:active {
		background: var(--c-wash);
	}

	h3 {
		font-size: 19px;
	}

	.feature-list p {
		margin-top: var(--s-1);
		color: var(--c-ink-2);
		font-size: 16px;
	}

	/* 最近更新：最新一个版本的前三条 */
	.latest {
		padding-top: var(--s-8);
	}

	.latest-version {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--s-1) var(--s-3);
		margin-top: var(--s-3);
	}

	.latest-version strong {
		font-size: 26px;
		font-weight: 800;
	}

	.latest-version span {
		color: var(--c-ink-2);
		font-size: 15px;
	}

	.latest ul {
		max-width: var(--measure);
		margin: var(--s-3) 0 var(--s-5);
		padding: 0;
		list-style: none;
	}

	.latest li {
		padding: var(--s-3) 0;
		border-top: 1px solid var(--c-line);
	}

	.latest time {
		display: block;
		color: var(--c-ink-3);
		font-size: 14px;
		font-weight: 600;
	}

	@media (min-width: 768px) {
		.hero {
			padding-top: var(--s-9);
			padding-bottom: var(--s-8);
		}

		h1 {
			font-size: 50px;
			line-height: 1.22;
		}

		.hero-sub {
			font-size: 20px;
		}

		h2 {
			font-size: 28px;
		}

		.day-inner {
			padding-top: var(--s-8);
			padding-bottom: var(--s-8);
		}

		.day-summary {
			font-size: 21px;
		}

		.day-events {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--s-5) var(--s-6);
		}

		.feature-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--s-7);
		}
	}

	@media (min-width: 1100px) {
		.shots-row {
			justify-content: space-between;
			margin-left: 0;
			margin-right: 0;
			padding-left: 0;
			padding-right: 0;
			overflow: visible;
		}

		.shots-row > :global(*) {
			width: 230px;
		}

		.shots-row > .shots-watch {
			width: 168px;
		}
	}
</style>
