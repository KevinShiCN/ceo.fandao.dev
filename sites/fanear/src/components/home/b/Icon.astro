---
// 首页 B 版用的功能图标：同一种画法，24 格、线宽 2、圆头，颜色跟着文字走。
// 只画有意思的东西（App 里那几个键、功能清单每一条），不做装饰。
export type IconName =
	| 'no'
	| 'note'
	| 'todo'
	| 'edit'
	| 'caught'
	| 'watch'
	| 'text'
	| 'person'
	| 'ribbon'
	| 'heart'
	| 'key';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const PATHS: Record<IconName, string[]> = {
	no: ['M6.5 6.5l11 11', 'M17.5 6.5l-11 11'],
	note: ['M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-8l-4 3v-3H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z', 'M8 9.5h8', 'M8 12.5h5'],
	todo: ['M5 12.5l4.5 4.5L19 7.5'],
	edit: ['M4.5 19.5h4l10-10-4-4-10 10v4z', 'M13 7l4 4'],
	caught: ['M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z', 'M8 12l3 3 5-6'],
	watch: ['M9 6h6a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3z', 'M9 6l.5-3h5l.5 3', 'M9 18l.5 3h5l.5-3', 'M12 10v2.5l1.5 1'],
	text: ['M4 6h16', 'M4 10h16', 'M4 14h10', 'M4 18h7'],
	person: ['M12 4.5a3.5 3.5 0 1 1 0 7a3.5 3.5 0 0 1 0-7z', 'M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5'],
	ribbon: ['M4 9h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1z', 'M9 9v6', 'M14 9v6'],
	heart: ['M12 19.5s-7-4.3-7-9.7A3.9 3.9 0 0 1 12 7.4a3.9 3.9 0 0 1 7 2.4c0 5.4-7 9.7-7 9.7z'],
	key: ['M8 10.5a4 4 0 1 1 0 8a4 4 0 0 1 0-8z', 'M10.8 11.7L19 3.5', 'M16 6.5l2 2', 'M13.8 8.7l2 2'],
};
---

<svg
	class:list={['icon', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{PATHS[name].map((d) => <path d={d} />)}
</svg>

<style>
	.icon {
		display: inline-block;
		flex: none;
		vertical-align: -0.2em;
	}
</style>
