---
// 首页（10-13 本人选定的 C 版「真机」）：真 App 截图当主角，像一份产品说明。首屏是图标、名字和一组大的真机；
// 往下按「手表上 → 手机上」的顺序，一屏讲一件事、配这一屏的截图；再是用你自己的账号、最近更新。
// 文案只取 src/lib/ 里已经核对过的句子（功能清单、截图说明、状态句），不另加事实。
import { SHOTS } from '../../lib/shots';
import Account from './c/Account.astro';
import Chapter from './c/Chapter.astro';
import Hero from './c/Hero.astro';
import Latest from './c/Latest.astro';
import Points from './c/Points.astro';
import Watch from './c/Watch.astro';
import Why from './c/Why.astro';
import { feature, point } from './c/pick';
import Shot from '../Shot.astro';
import '../../styles/scroll-motion.css';

const today = feature('today');
const transcribe = feature('transcribe');
const organize = feature('organize');
const health = feature('health');
const commitments = feature('commitments');

// 「24 小时没回，自动进待办。」拆成大字的「24 小时」和后半句
const autoLine = point(commitments, '24 小时');
const auto = autoLine.match(/^(\d+ 小时)(.+)$/);
if (!auto) throw new Error(`功能「commitments」里那句「${autoLine}」拆不开，改一下首页 C 版`);

const phoneSizes = '(min-width: 1100px) 300px, (min-width: 768px) 280px, 64vw';
---

<main id="main" class="home-c">
	<Hero />

	<div class="group">
		<h2>为什么做</h2>
	</div>
	<Why />

	<div class="group">
		<h2>手表上</h2>
	</div>
	<Watch />

	<div class="group group-phone">
		<h2>手机上</h2>
	</div>

	<div class="story">
		<Chapter id="h-c-today" screen={SHOTS.today.caption} title={today.title} lead={today.lead}>
			<Points items={today.points} />
			<Shot slot="figure" id="today" caption={false} sizes={phoneSizes} />
		</Chapter>

		<Chapter
			id="h-c-conversation"
			screen={SHOTS.conversation.caption}
			title={transcribe.title}
			lead={transcribe.lead}
			flip
		>
			<Points items={[point(transcribe, '说话人')]} />
			<div class="sub">
				<h4>{organize.title}</h4>
				<p>{organize.lead}</p>
				<Points items={[point(organize, '最近'), point(organize, '认错')]} />
			</div>
			<div class="sub">
				<h4>{health.title}</h4>
				<p>{health.lead}</p>
				<Points items={[point(health, '锁着')]} />
			</div>
			<Shot slot="figure" id="conversation" caption={false} sizes={phoneSizes} />
		</Chapter>

		<Chapter
			id="h-c-commitments"
			screen={SHOTS.commitments.caption}
			title={commitments.title}
			lead={commitments.lead}
		>
			<Points items={[point(commitments, '三个键'), point(commitments, '5 秒')]} />
			<p class="auto">
				<strong>{auto[1]}</strong>
				<span>{auto[2]}</span>
			</p>
			<Shot slot="figure" id="commitments" caption={false} sizes={phoneSizes} />
		</Chapter>

		{/* 电脑上往下滑时用的那一部手机：钉在右边不动，三屏跟着左边三节一屏一屏换（styles/scroll-motion.css）。
		    手机、平板、不支持滚动动画的浏览器和设了「减弱动态效果」的不显示它，还是每节自带截图 */}
		<div class="story-phone">
			<div class="story-pin">
				<Shot id="today" stack={['conversation', 'commitments']} caption={false} sizes="300px" class="story-shot" />
			</div>
		</div>
	</div>

	<Account />
	<Latest />
</main>

<style>
	.home-c > :global(section:not(.account)),
	.story {
		max-width: calc(var(--page-max) + 2 * var(--gutter));
		margin-left: auto;
		margin-right: auto;
		padding-left: var(--gutter);
		padding-right: var(--gutter);
	}

	.story-phone {
		display: none;
	}

	/* 「手表上」「手机上」：一道深墨粗线开头，像说明书换一章 */
	/* 粗线只画在版心里，不伸进两边留白，所以用外边距收进来 */
	.group {
		max-width: var(--page-max);
		margin-left: max(var(--gutter), calc((100% - var(--page-max)) / 2));
		margin-right: max(var(--gutter), calc((100% - var(--page-max)) / 2));
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s-1) var(--s-4);
		margin-top: var(--s-8);
		padding-top: var(--s-3);
		border-top: 3px solid var(--c-ink);
	}

	.group h2 {
		font-size: 20px;
		font-weight: 800;
	}

	.group-phone {
		margin-top: var(--s-9);
	}

	/* 一段对话里，认出「我」和心率两小节 */
	.sub {
		margin-top: var(--s-6);
	}

	.sub h4 {
		font-size: 19px;
		font-weight: 700;
	}

	.sub > p {
		margin-top: var(--s-1);
		color: var(--c-ink-2);
		font-size: 16px;
		line-height: 1.65;
	}

	/* 24 小时没回自动进待办：这一节唯一的大字 */
	.auto {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 var(--s-3);
		margin-top: var(--s-5);
		padding-top: var(--s-4);
		border-top: 1px solid var(--c-line);
	}

	.auto strong {
		font-size: 40px;
		font-weight: 800;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}

	.auto span {
		font-size: 18px;
		font-weight: 600;
	}

	@media (min-width: 768px) {
		.group {
			margin-top: var(--s-9);
		}

		.group h2 {
			font-size: 22px;
		}

		.group-phone {
			margin-top: calc(var(--s-9) + var(--s-6));
		}

		.auto strong {
			font-size: 48px;
		}
	}
</style>
