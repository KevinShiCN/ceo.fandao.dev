---
// 页头：左边 LOGO、名字和现在的状态（点了回首页），右边四个栏目。
// 手机上分两行：第一行 LOGO 和状态，第二行四个栏目；宽屏并成一行。
import { NAV, SITE, STATUS } from '../lib/site';
import { stripBase, withBase } from '../lib/url';
import Logo from './Logo.astro';

const path = stripBase(Astro.url.pathname);
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={withBase('/')}>
			<Logo size={26} />
			<span class="brand-name">{SITE.name}</span>
			<span class="brand-en">{SITE.nameEn}</span>
		</a>
		<a class="status" href={withBase('/changelog/')} title={STATUS.text}>{STATUS.label}</a>
		<nav class="site-nav" aria-label="栏目">
			{
				NAV.map((item) => (
					<a href={withBase(item.path)} aria-current={path.startsWith(item.path) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--c-line);
		background: var(--c-paper);
	}

	.header-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: var(--s-3);
		max-width: calc(var(--page-max) + 2 * var(--gutter));
		margin: 0 auto;
		padding: var(--s-2) var(--gutter) 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--s-2);
		min-height: 44px;
		color: var(--c-ink);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--c-ink);
	}

	.brand-name {
		font-size: 19px;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.brand-en {
		color: var(--c-ink-3);
		font-size: 15px;
		font-weight: 600;
	}

	/* 状态是一个能点的小方标签：点了去更新记录看「未发布」 */
	.status {
		display: inline-flex;
		align-items: center;
		min-height: 26px;
		padding: 0 var(--s-2);
		border: 1px solid var(--c-ink-3);
		border-radius: var(--r-tag);
		color: var(--c-ink-2);
		font-size: 13px;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
	}

	.status:hover {
		border-color: var(--c-ink);
		color: var(--c-ink);
	}

	.status:active {
		background: var(--c-wash);
	}

	.site-nav {
		display: flex;
		flex-basis: 100%;
		gap: var(--s-1);
		margin-left: calc(-1 * var(--s-3));
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--s-3);
		border-bottom: 3px solid transparent;
		color: var(--c-ink-2);
		font-size: 16px;
		text-decoration: none;
	}

	.site-nav a:hover {
		color: var(--c-ink);
	}

	.site-nav a:active {
		background: var(--c-wash);
	}

	/* 当前栏目：字变深、底下一道我蓝 */
	.site-nav a[aria-current='page'] {
		border-bottom-color: var(--c-me);
		color: var(--c-ink);
		font-weight: 600;
	}

	/* 窄手机（360 宽）四个栏目一行放不下，每个栏目左右少留一点 */
	@media (max-width: 399px) {
		.site-nav {
			margin-left: calc(-1 * var(--s-2));
		}

		.site-nav a {
			padding: 0 var(--s-2);
		}
	}

	@media (min-width: 720px) {
		.header-inner {
			flex-wrap: nowrap;
			padding-top: 0;
		}

		.site-nav {
			flex-basis: auto;
			margin-left: auto;
			margin-right: calc(-1 * var(--s-3));
		}

		.site-nav a {
			min-height: 64px;
		}
	}
</style>
