---
import '../styles/base.css';
import '../styles/theme.css';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import BaseHead from '../components/BaseHead.astro';
import Search from '../components/Search.astro';
import SearchIcon from '../components/SearchIcon.astro';
import { AUTHOR, LINKS } from '../consts';
import { navItems } from '../lib/nav';
import { withBase } from '../lib/url';

interface Props {
	title?: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	/** 首页用大横幅代替顶栏 */
	topbar?: boolean;
	/** 只有 404 页传 false，见 BaseHead */
	canonical?: boolean;
}

const { title, description, image, type, topbar = true, canonical = true } = Astro.props;
// 顶栏左边的头像和名字就是回首页，右边只放其余两项
const home = withBase('/');
const nav = navItems(Astro.url.pathname).filter((item) => item.href !== home);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={image} type={type} canonical={canonical} />
	</head>
	<body>
		<a class="skip-link" href="#main">跳到正文</a>
		{
			topbar && (
				<header class="topbar">
					<div class="topbar-inner">
						<a class="me" href={home}>
							<Image class="me-avatar" src={avatar} alt="" width={64} height={64} />
							<span>{AUTHOR.name}</span>
						</a>
						<div class="topbar-right">
							<nav class="topbar-nav" aria-label="站点导航">
								{nav.map((item) => (
									<a
										href={item.href}
										aria-current={item.current ? 'page' : undefined}
										class:list={[item.secondary && 'nav-secondary']}
									>
										{item.label}
									</a>
								))}
							</nav>
							<button
								type="button"
								class="topbar-search"
								aria-haspopup="dialog"
								aria-controls="search-dialog"
								data-search-open="search-dialog"
							>
								<SearchIcon class="topbar-search-icon" />
								<span>搜索</span>
							</button>
						</div>
					</div>
				</header>
			)
		}
		{
			/* 顶栏「搜索」打开的浮层；首页没有顶栏，搜索框直接放在文章列表上方 */
			topbar && (
				<dialog id="search-dialog" class="search-dialog" aria-label="搜文章">
					<Search id="dialog-search" variant="panel">
						<button type="button" class="search-close" data-search-close>
							关闭
						</button>
					</Search>
				</dialog>
			)
		}
		<slot />
		<footer class="site-footer">
			<div class="footer-inner">
				<p class="tight-punct">{AUTHOR.fullName}</p>
				<p class="footer-links">
					<a href={LINKS.x.href}>X {LINKS.x.handle}</a>
					<a href={withBase('/tools/')}>工具库</a>
					<a href={withBase('/about/')}>关于</a>
					<a href={LINKS.rss.href}>RSS</a>
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.topbar {
		border-bottom: 1px solid var(--c-line);
	}

	/* 顶栏和页脚按整页宽度排，电脑上跟首页两栏、正文加目录的左右边对齐 */
	.topbar-inner,
	.footer-inner {
		max-width: calc(var(--page-max) + 2 * var(--gutter));
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.topbar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 56px;
	}

	.me {
		display: inline-flex;
		align-items: center;
		gap: var(--s-2);
		min-height: 44px;
		color: var(--c-text);
		font-weight: 600;
		text-decoration: none;
	}

	.me :global(.me-avatar) {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		object-fit: cover;
	}

	.topbar-right {
		display: flex;
		align-items: center;
		gap: var(--s-1);
	}

	.topbar-nav {
		display: flex;
		gap: var(--s-1);
	}

	.topbar-nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--s-3);
		color: var(--c-text-2);
		font-size: 15px;
		text-decoration: none;
	}

	.topbar-nav a:hover,
	.topbar-nav a[aria-current='page'] {
		color: var(--c-link);
	}

	.topbar-search {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		margin: 0;
		padding: 0 var(--s-3);
		border: 0;
		background: none;
		color: var(--c-text-2);
		font: inherit;
		font-size: 15px;
		cursor: pointer;
		touch-action: manipulation;
	}

	.topbar-search:hover {
		color: var(--c-link);
	}

	.topbar-search:active {
		color: var(--c-link-hover);
	}

	.topbar-search :global(.topbar-search-icon) {
		width: 17px;
		height: 17px;
	}

	/* 窄手机（430 以下）：头像名字加四项排不下，会挤成两行字。先收起 RSS（页脚和首页都还有），
	   链接左右留白收窄一点；360 宽也排得下 */
	@media (max-width: 429px) {
		.topbar-nav .nav-secondary {
			display: none;
		}

		.topbar-nav a,
		.topbar-search {
			padding: 0 10px;
		}
	}

	/* 搜索浮层（里面的结构和行为在 Search.astro）：手机上占满屏幕，电脑上是靠上居中的面板 */
	.search-dialog {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: var(--c-bg);
		color: var(--c-text);
		/* 浮层里滑到头不带着后面的页面滚 */
		overscroll-behavior: contain;
	}

	.search-dialog[open] {
		display: flex;
		flex-direction: column;
	}

	.search-dialog::backdrop {
		background: var(--c-scrim);
	}

	.search-close {
		flex: none;
		min-height: 44px;
		margin: 0;
		padding: 0 var(--s-2);
		border: 0;
		background: none;
		color: var(--c-link);
		font: inherit;
		font-size: 16px;
		cursor: pointer;
		touch-action: manipulation;
	}

	.search-close:hover,
	.search-close:active {
		color: var(--c-link-hover);
	}

	/* 浮层打开时后面的页面不跟着滚；留出滚动条的位置，页面不左右跳 */
	:global(html.search-open) {
		overflow: hidden;
		scrollbar-gutter: stable;
	}

	@media (min-width: 768px) {
		/* 浏览器默认把弹出的 dialog 上下撑满（top、bottom 都是 0），bottom 放开，面板高度随内容，最高 76vh */
		.search-dialog {
			bottom: auto;
			width: min(720px, calc(100% - 2 * var(--gutter)));
			height: auto;
			max-height: min(76vh, 760px);
			margin: 12vh auto auto;
			border: 1px solid var(--c-line);
			border-radius: 12px;
			box-shadow: 0 24px 64px var(--c-panel-shadow);
		}
	}

	.site-footer {
		margin-top: var(--s-9);
		border-top: 1px solid var(--c-line);
		color: var(--c-text-2);
		font-size: 14px;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--s-2) var(--s-5);
		padding-top: var(--s-6);
		padding-bottom: var(--s-7);
	}

	.footer-inner p {
		margin: 0;
	}

	.footer-links {
		display: flex;
		gap: var(--s-4);
	}

	.footer-links a {
		color: var(--c-text-2);
	}
</style>
